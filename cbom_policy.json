{
  "policy_metadata": {
    "version": "2.1.0",
    "name": "Enterprise Post-Quantum Cryptography & CBOM Policy",
    "last_updated": "2026-09-30"
  },
  "crqc_arrival_scenarios": {
    "pessimistic": 2033,
    "central": 2038,
    "optimistic": 2045
  },
  "default_shelf_life_x": {
    "ephemeral_session": {
      "years": 0.01,
      "description": "Session tokens, OTPs, ephemeral TLS handshake state"
    },
    "operational_logs": {
      "years": 1.0,
      "description": "System access logs, audit trails, and non-sensitive telemetry"
    },
    "payment_card_data": {
      "years": 3.0,
      "description": "PCI-DSS cardholder dispute and authorization data"
    },
    "customer_pii": {
      "years": 5.0,
      "description": "Standard customer profile data, emails, and contact records"
    },
    "corporate_financials": {
      "years": 7.0,
      "description": "Statutory audit trails, corporate tax filings, and general ledger"
    },
    "legal_contracts": {
      "years": 10.0,
      "description": "Executed vendor agreements, NDAs, and corporate legal archives"
    },
    "proprietary_ip": {
      "years": 15.0,
      "description": "Trade secrets, patents, software source code, architectural blueprints"
    },
    "government_classified": {
      "years": 20.0,
      "description": "Defense-adjacent documents, restricted government project artifacts"
    },
    "healthcare_phi": {
      "years": 25.0,
      "description": "Pediatric health records, clinical trials, HIPAA-protected records"
    },
    "biometrics_and_genomics": {
      "years": 75.0,
      "description": "Human genome sequences, biometric identity templates (non-revocable)"
    },
    "custom_user_defined": {
      "years": 42.5,
      "description": "User-specified custom data retention / shelf-life period"
    }
  },
  "asset_classification_overrides": {
    "auth_tokens_redis": "ephemeral_session",
    "billing_ledger_postgres": "corporate_financials",
    "pacs_imaging_s3": "healthcare_phi",
    "biometric_auth_service": "biometrics_and_genomics"
  },
  "algorithm_risk_definitions": {
    "RSA": {
      "quantum_safe": false,
      "shor_vulnerable": true,
      "replacement": "ML-KEM-768 / ML-DSA-65 (FIPS 203/204)",
      "severity": "CRITICAL"
    },
    "ECDSA": {
      "quantum_safe": false,
      "shor_vulnerable": true,
      "replacement": "ML-DSA-65 (FIPS 204)",
      "severity": "CRITICAL"
    },
    "ECDH": {
      "quantum_safe": false,
      "shor_vulnerable": true,
      "replacement": "ML-KEM-768 (FIPS 203)",
      "severity": "CRITICAL"
    },
    "DSA": {
      "quantum_safe": false,
