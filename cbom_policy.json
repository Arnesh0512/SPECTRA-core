    "AES-128": {
      "quantum_safe": false,
      "shor_vulnerable": false,
      "grover_vulnerable": true,
      "replacement": "AES-256-GCM",
      "severity": "MEDIUM"
    },
    "AES-256": {
      "quantum_safe": true,
